# Copy this file to .env.local and replace the placeholders.
# Keep .env.local private. Never commit real credentials.

# Required: MongoDB connection string. URL-encode special characters in credentials.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/pingme?retryWrites=true&w=majority
# For a local MongoDB server, use: mongodb://127.0.0.1:27017/pingme

# Required: a unique random secret with at least 32 characters.
# Generate one: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Optional: persistent Redis with Pub/Sub support for distributed WebSocket delivery.
# Use redis:// or rediss:// (TLS), not an HTTP-only Redis REST endpoint.
# Without Redis, the app uses periodic synchronization.
REDIS_URL=
